{
  "name": "dsh-run-monitor",
  "version": "0.2.18",
  "description": "Run monitor: running, awaiting-reply and finished sessions in the sidebar, one click to open the conversation. 运行监控：在侧边栏查看执行中、待回复与已完成的会话任务，点击即可跳转到对应对话。",
  "keywords": ["dsh", "dsh-plugin", "dsh-bundle", "sidebar", "notifications"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yven/dsh-run-monitor.git"
  },
  "homepage": "https://github.com/Yven/dsh-run-monitor#readme",
  "bugs": {
    "url": "https://github.com/Yven/dsh-run-monitor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    },
    "manifestVersion": 1
  }
}
